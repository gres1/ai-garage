{
  "_note": "Committed template. loadConn() falls back here for a fresh install. Generic providers only — no user/host specifics. Real user list lives in ~/.config/localhost-control/connections.json (gitignored).",
  "version": 1,
  "items": [
    { "id": "openrouter", "label": "OpenRouter", "group": "apikey", "env": ["OPENROUTER_API_KEY"],
      "health": { "method": "GET", "url": "https://openrouter.ai/api/v1/key", "headers": { "Authorization": "Bearer ${OPENROUTER_API_KEY}" }, "okCodes": [200] },
      "dashboard": "https://openrouter.ai/keys", "reconnect": { "type": "dashboard", "hint": "Создать ключ → вставить в .env" } },
    { "id": "anthropic", "label": "Anthropic", "group": "apikey", "env": ["ANTHROPIC_API_KEY"],
      "health": { "method": "GET", "url": "https://api.anthropic.com/v1/models", "headers": { "x-api-key": "${ANTHROPIC_API_KEY}", "anthropic-version": "2023-06-01" }, "okCodes": [200] },
      "dashboard": "https://console.anthropic.com/settings/keys", "reconnect": { "type": "dashboard", "hint": "Console → API Keys" } },
    { "id": "openai", "label": "OpenAI", "group": "apikey", "env": ["OPENAI_API_KEY"],
      "health": { "method": "GET", "url": "https://api.openai.com/v1/models", "headers": { "Authorization": "Bearer ${OPENAI_API_KEY}" }, "okCodes": [200] },
      "dashboard": "https://platform.openai.com/api-keys", "reconnect": { "type": "dashboard", "hint": "Platform → API keys" } },
    { "id": "gemini", "label": "Gemini", "group": "apikey", "env": ["GEMINI_API_KEY"],
      "health": { "method": "GET", "url": "https://generativelanguage.googleapis.com/v1beta/models?key=${GEMINI_API_KEY}", "okCodes": [200] },
      "dashboard": "https://aistudio.google.com/apikey", "reconnect": { "type": "dashboard", "hint": "AI Studio → Get API key" } },
    { "id": "linear", "label": "Linear", "group": "apikey", "env": ["LINEAR_API_KEY"],
      "health": { "method": "POST", "url": "https://api.linear.app/graphql", "headers": { "Authorization": "${LINEAR_API_KEY}", "Content-Type": "application/json" }, "body": { "query": "{viewer{id}}" }, "okCodes": [200] },
      "dashboard": "https://linear.app/settings/api", "reconnect": { "type": "dashboard", "hint": "Settings → API → Personal keys" } },
    { "id": "github", "label": "GitHub", "group": "apikey", "env": ["GITHUB_PERSONAL_ACCESS_TOKEN"],
      "health": { "method": "GET", "url": "https://api.github.com/user", "headers": { "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}", "User-Agent": "ai-garage" }, "okCodes": [200] },
      "dashboard": "https://github.com/settings/tokens", "reconnect": { "type": "dashboard", "hint": "Settings → Developer → Tokens" } },
    { "id": "supabase", "label": "Supabase", "group": "apikey", "env": ["SUPABASE_ACCESS_TOKEN"],
      "health": { "method": "GET", "url": "https://api.supabase.com/v1/projects", "headers": { "Authorization": "Bearer ${SUPABASE_ACCESS_TOKEN}" }, "okCodes": [200] },
      "dashboard": "https://supabase.com/dashboard/account/tokens", "reconnect": { "type": "dashboard", "hint": "Account → Access tokens" } },
    { "id": "firecrawl", "label": "Firecrawl", "group": "apikey", "env": ["FIRECRAWL_API_KEY"],
      "health": { "method": "POST", "url": "https://api.firecrawl.dev/v1/scrape", "headers": { "Authorization": "Bearer ${FIRECRAWL_API_KEY}", "Content-Type": "application/json" }, "body": { "url": "https://example.com" }, "okCodes": [200], "warnCodes": [402] },
      "dashboard": "https://www.firecrawl.dev/app/api-keys", "reconnect": { "type": "dashboard", "hint": "402 = кончились кредиты → пополнить" } },
    { "id": "n8n", "label": "n8n", "group": "apikey", "env": ["N8N_API_URL", "N8N_API_KEY"],
      "health": { "method": "GET", "url": "${N8N_API_URL}/api/v1/workflows?limit=1", "headers": { "X-N8N-API-KEY": "${N8N_API_KEY}" }, "okCodes": [200] },
      "dashboard": null, "reconnect": { "type": "dashboard", "hint": "n8n → Settings → n8n API" } },
    { "id": "figma", "label": "Figma", "group": "apikey", "env": ["FIGMA_API_KEY"],
      "health": { "method": "GET", "url": "https://api.figma.com/v1/me", "headers": { "X-Figma-Token": "${FIGMA_API_KEY}" }, "okCodes": [200] },
      "dashboard": "https://www.figma.com/developers/api#access-tokens", "reconnect": { "type": "dashboard", "hint": "Settings → Personal access tokens" } },
    { "id": "vercel", "label": "Vercel", "group": "apikey", "env": ["VERCEL_TOKEN"],
      "health": { "method": "GET", "url": "https://api.vercel.com/v2/user", "headers": { "Authorization": "Bearer ${VERCEL_TOKEN}" }, "okCodes": [200] },
      "dashboard": "https://vercel.com/account/tokens", "reconnect": { "type": "dashboard", "hint": "Account → Tokens" } },

    { "id": "composio", "label": "Composio", "group": "composio", "env": ["COMPOSIO_API_KEY"], "special": "composio",
      "dashboard": "https://platform.composio.dev", "reconnect": { "type": "composio_connect", "hint": "Подключить сервис через OAuth-consent" } },

    { "id": "mcp", "label": "MCP-серверы", "group": "mcp", "special": "mcp",
      "dashboard": null, "reconnect": { "type": "cli", "cmd": "claude mcp list", "hint": "Переподключить / авторизовать сервер" } }
  ]
}
